{
  "level": "a1",
  "lessons": [
    {
      "number": 18,
      "title": "Conversation: At a Café",
      "titleNative": "Suhbat: kafeda",
      "items": [
        {
          "uz": "Xush kelibsiz! Nima buyurasiz?",
          "en": "Welcome! What would you like to order?"
        },
        {
          "uz": "Bir choy, iltimos.",
          "en": "One tea, please."
        },
        {
          "uz": "Shirinlik xohlaysizmi?",
          "en": "Would you like something sweet?"
        },
        {
          "uz": "Ha, tort olay.",
          "en": "Yes, I'll take some cake."
        },
        {
          "uz": "Boshqa xohishingiz bormi?",
          "en": "Do you have any other wishes?"
        },
        {
          "uz": "Yo'q, rahmat, shu yetarli.",
          "en": "No, thank you, that's enough."
        },
        {
          "uz": "Jami qancha bo'ldi?",
          "en": "How much does it come to in total?"
        },
        {
          "uz": "O'ttiz ming so'm bo'ladi.",
          "en": "It's thirty thousand som."
        },
        {
          "uz": "Mana, iltimos.",
          "en": "Here you go, please."
        },
        {
          "uz": "Rahmat, yoqimli ishtaha!",
          "en": "Thank you, enjoy your meal!"
        },
        {
          "uz": "Bu yerda tarvaqaylab ovqatlanish mumkinmi?",
          "en": "Can I eat outside here?"
        },
        {
          "uz": "Albatta, hovlida joy bor.",
          "en": "Of course, there's space in the yard."
        }
      ]
    },
    {
      "number": 19,
      "title": "Conversation: Asking Directions",
      "titleNative": "Suhbat: yo'l so'rash",
      "items": [
        {
          "uz": "Kechirasiz, bozor qayerda?",
          "en": "Excuse me, where is the market?"
        },
        {
          "uz": "To'g'riga yuring, keyin chapga buriling.",
          "en": "Go straight, then turn left."
        },
        {
          "uz": "Bu yerdan uzoqmi?",
          "en": "Is it far from here?"
        },
        {
          "uz": "Yo'q, besh daqiqalik yo'l.",
          "en": "No, it's a five-minute walk."
        },
        {
          "uz": "Piyoda borsam bo'ladimi?",
          "en": "Can I walk there?"
        },
        {
          "uz": "Ha, albatta bo'ladi.",
          "en": "Yes, of course you can."
        },
        {
          "uz": "Yaqin-orada bekat bormi?",
          "en": "Is there a bus stop nearby?"
        },
        {
          "uz": "Ha, o'sha do'kon yonida.",
          "en": "Yes, next to that shop."
        },
        {
          "uz": "Rahmat katta yordamingiz uchun!",
          "en": "Thank you very much for your help!"
        },
        {
          "uz": "Arzimaydi, yaxshi boring!",
          "en": "You're welcome, have a good trip!"
        },
        {
          "uz": "Bu ko'cha nima deb ataladi?",
          "en": "What is this street called?"
        },
        {
          "uz": "Bu Navoiy ko'chasi.",
          "en": "This is Navoi street."
        }
      ]
    }
  ]
}
