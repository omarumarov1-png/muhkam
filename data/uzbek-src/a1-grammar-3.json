  "grammarTopics": {
    "a1-jussive": {
      "title": "Third-Person Command: -sin",
      "pattern": "[verb stem] + -sin (let him/her/it ~)",
      "explanation": "To tell a third party to do something, or to grant permission indirectly, Uzbek adds -sin to the verb stem: kelsin! (let him/her come!), boshlasin (let them begin). It's the third-person counterpart to the plain imperative already covered for \"you\".",
      "fact": "-sin shows up in one very common fixed phrase every learner meets early: nima bo'lsa bo'lsin (\"come what may\", literally \"let whatever happens, happen\") -- the same tiny suffix carries both ordinary third-person commands and this fatalistic idiom.",
      "dialogue": [
        {
          "sp": "A",
          "native": "U kirsinmi?",
          "en": "Should he/she come in?"
        },
        {
          "sp": "B",
          "native": "Ha, kirsin.",
          "en": "Yes, let him/her come in."
        }
      ]
    },
    "a1-hatto-faqat": {
      "title": "Emphatic Particles: hatto & faqat",
      "pattern": "hatto + [clause] (even ~) · faqat + [word] (only ~)",
      "explanation": "Hatto (\"even\") adds emphasis to something surprising: hatto bolalar ham biladi (even children know this). Faqat (\"only\") restricts a statement to just one thing: men faqat choy ichaman (I only drink tea).",
      "fact": "Both words sit BEFORE the thing they emphasize, mirroring English \"even\" and \"only\" almost word-for-word in placement -- one of the few places Uzbek's usual head-final habits line up neatly with English word order.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Siz go'sht yeysizmi?",
          "en": "Do you eat meat?"
        },
        {
          "sp": "B",
          "native": "Yo'q, men faqat sabzavot yeyman.",
          "en": "No, I only eat vegetables."
        }
      ]
    }
  },
