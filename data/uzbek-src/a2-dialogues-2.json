{
  "level": "a2",
  "lessons": [
    {
      "number": 126,
      "title": "Conversation: At the Airport",
      "titleNative": "Suhbat: aeroportda",
      "items": [
        {
          "uz": "Chiptangizni va pasportingizni ko'rsating.",
          "en": "Please show your ticket and passport."
        },
        {
          "uz": "Mana, marhamat.",
          "en": "Here you go."
        },
        {
          "uz": "Yukingiz bormi?",
          "en": "Do you have luggage?"
        },
        {
          "uz": "Ha, bitta katta chamadonim bor.",
          "en": "Yes, I have one big suitcase."
        },
        {
          "uz": "Reysingiz necha soatda?",
          "en": "What time is your flight?"
        },
        {
          "uz": "Mening reysim ikki soatdan keyin.",
          "en": "My flight is in two hours."
        },
        {
          "uz": "Qaysi darvozadan chiqishim kerak?",
          "en": "Which gate should I go through?"
        },
        {
          "uz": "O'n beshinchi darvozadan.",
          "en": "Through gate fifteen."
        },
        {
          "uz": "Reys kechikmoqda ekan.",
          "en": "It turns out the flight is delayed."
        },
        {
          "uz": "Necha daqiqaga kechikadi?",
          "en": "How many minutes will it be delayed?"
        },
        {
          "uz": "Taxminan o'ttiz daqiqaga.",
          "en": "Approximately thirty minutes."
        },
        {
          "uz": "Xavfsiz parvoz tilayman!",
          "en": "I wish you a safe flight!"
        }
      ]
    }
  ]
}
