  "lessons": [
    {
      "number": 131,
      "title": "Conversation: Renting an Apartment",
      "titleNative": "Suhbat: kvartira ijarasi",
      "items": [
        {
          "uz": "Bu kvartira oyiga qancha turadi?",
          "en": "How much does this apartment cost per month?"
        },
        {
          "uz": "Besh million so'm, kommunal xizmatlar bilan.",
          "en": "Five million som, including utilities."
        },
        {
          "uz": "Nechta xona bor?",
          "en": "How many rooms are there?"
        },
        {
          "uz": "Ikkita yotoq xona va bitta mehmonxona.",
          "en": "Two bedrooms and one living room."
        },
        {
          "uz": "Bu yerdan ishga borish qulaymi?",
          "en": "Is it convenient to get to work from here?"
        },
        {
          "uz": "Ha, avtobus bekati yaqinda.",
          "en": "Yes, the bus stop is nearby."
        },
        {
          "uz": "Shartnomani qancha muddatga tuzamiz?",
          "en": "For how long shall we draw up the contract?"
        },
        {
          "uz": "Bir yilga, keyin uzaytirish mumkin.",
          "en": "For one year, then it can be extended."
        },
        {
          "uz": "Old to'lov kerakmi?",
          "en": "Is a deposit required?"
        },
        {
          "uz": "Ha, bir oylik to'lov oldindan kerak.",
          "en": "Yes, one month's payment is required in advance."
        },
        {
          "uz": "Kvartirani ko'rsam bo'ladimi?",
          "en": "May I see the apartment?"
        },
        {
          "uz": "Albatta, hozir ko'rsataman.",
          "en": "Of course, I'll show it now."
        }
      ]
    }
  ]
}
