{
  "level": "a2",
  "lessons": [
    {
      "number": 164,
      "title": "Conversation: At the Pharmacy",
      "titleNative": "Suhbat: dorixonada",
      "items": [
        {
          "uz": "Sizga qanday yordam bera olaman?",
          "en": "How can I help you?"
        },
        {
          "uz": "Menga boshim uchun dori kerak.",
          "en": "I need medicine for my head."
        },
        {
          "uz": "Bu dorini kuniga uch marta iching.",
          "en": "Take this medicine three times a day."
        },
        {
          "uz": "Bu dori retseptsiz sotiladimi?",
          "en": "Is this medicine sold without a prescription?"
        },
        {
          "uz": "Ha, bu dori retseptsiz sotiladi.",
          "en": "Yes, this medicine is sold without a prescription."
        },
        {
          "uz": "Hatto bitta tabletka ham yordam beradi.",
          "en": "Even one tablet will help."
        },
        {
          "uz": "Menga faqat shu dori kerak edi.",
          "en": "I only needed this medicine."
        },
        {
          "uz": "Boshqa narsa kerakmi?",
          "en": "Do you need anything else?"
        },
        {
          "uz": "Yo'q, shu yetarli, rahmat.",
          "en": "No, this is enough, thank you."
        },
        {
          "uz": "Tez tuzalib keting!",
          "en": "Get well soon!"
        }
      ]
    }
  ]
}
