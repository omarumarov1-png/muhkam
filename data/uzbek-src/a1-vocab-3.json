{
  "level": "a1",
  "lessons": [
    {
      "number": 157,
      "title": "Seasons & Months",
      "titleNative": "Fasllar va oylar",
      "items": [
        {
          "uz": "Bahorda gullar ochiladi.",
          "en": "Flowers bloom in spring."
        },
        {
          "uz": "Yozda men dengizga boraman.",
          "en": "In summer I go to the sea."
        },
        {
          "uz": "Kuzda barglar sarg'ayadi.",
          "en": "In autumn the leaves turn yellow."
        },
        {
          "uz": "Qishda qor yog'adi.",
          "en": "It snows in winter."
        },
        {
          "uz": "Yanvar yilning birinchi oyi.",
          "en": "January is the first month of the year."
        },
        {
          "uz": "Iyul yozning eng issiq oyi.",
          "en": "July is the hottest month of summer."
        },
        {
          "uz": "Mening tug'ilgan oyim sentyabr.",
          "en": "My birth month is September."
        },
        {
          "uz": "Dekabrda yangi yil bayrami bo'ladi.",
          "en": "The New Year holiday is in December."
        },
        {
          "uz": "Bu yil bahor erta keldi.",
          "en": "Spring came early this year."
        },
        {
          "uz": "Har fasl o'ziga xos go'zallikka ega.",
          "en": "Every season has its own beauty."
        },
        {
          "uz": "Men kuzni eng ko'p yaxshi ko'raman.",
          "en": "I like autumn the most."
        },
        {
          "uz": "Qish tez orada tugaydi.",
          "en": "Winter will end soon."
        }
      ]
    },
    {
      "number": 158,
      "title": "Transportation",
      "titleNative": "Transport",
      "items": [
        {
          "uz": "Men ishga avtobusda boraman.",
          "en": "I go to work by bus."
        },
        {
          "uz": "U velosipedda maktabga boradi.",
          "en": "He/she goes to school by bicycle."
        },
        {
          "uz": "Bu shaharda metro yo'q.",
          "en": "There is no metro in this city."
        },
        {
          "uz": "Poyezd stansiyadan jo'nadi.",
          "en": "The train departs from the station."
        },
        {
          "uz": "Samolyot osmonga ko'tarildi.",
          "en": "The plane rose into the sky."
        },
        {
          "uz": "Men mashinamni ta'mirlatdim.",
          "en": "I had my car repaired."
        },
        {
          "uz": "Taksi tez orada yetib keladi.",
          "en": "The taxi will arrive soon."
        },
        {
          "uz": "Bu yo'lda mashinalar ko'p.",
          "en": "There are many cars on this road."
        },
        {
          "uz": "Kema portga yaqinlashmoqda.",
          "en": "The ship is approaching the port."
        },
        {
          "uz": "Men piyoda yurishni yaxshi ko'raman.",
          "en": "I like walking on foot."
        },
        {
          "uz": "Chipta narxi oshdi.",
          "en": "The ticket price increased."
        },
        {
          "uz": "Yo'l harakati qoidalariga rioya qiling.",
          "en": "Follow the traffic rules."
        }
      ]
    }
  ]
}
