    {
      "number": 161,
      "title": "Conversation: At School",
      "titleNative": "Suhbat: maktabda",
      "items": [
        {
          "uz": "Bugun qanday darslar bor?",
          "en": "What classes are there today?"
        },
        {
          "uz": "Bugun matematika va tarix bor.",
          "en": "Today there's math and history."
        },
        {
          "uz": "Uy vazifasini bajardingizmi?",
          "en": "Did you do your homework?"
        },
        {
          "uz": "Ha, kecha kechqurun bajardim.",
          "en": "Yes, I did it yesterday evening."
        },
        {
          "uz": "Imtihon qachon bo'ladi?",
          "en": "When is the exam?"
        },
        {
          "uz": "Imtihon kelasi hafta bo'ladi.",
          "en": "The exam is next week."
        },
        {
          "uz": "Hatto eng qiyin mavzuni ham tushundim.",
          "en": "I understood even the hardest topic."
        },
        {
          "uz": "Ustoz hammamizga yordam bersin.",
          "en": "Let the teacher help all of us."
        },
        {
          "uz": "Faqat ozgina vaqtimiz qoldi.",
          "en": "We only have a little time left."
        },
        {
          "uz": "Tez tayyorlanishimiz kerak.",
          "en": "We need to prepare quickly."
        }
      ]
    }
  ]
}
