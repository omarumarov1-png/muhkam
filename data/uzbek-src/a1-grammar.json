{
  "level": "a1",
  "grammarTopics": {
    "a1-pronouns-tobe": {
      "title": "Personal Pronouns & \"To Be\"",
      "pattern": "men/sen/u/biz/siz/ular + [noun/adj] + -man/-san/(-)/-miz/-siz/(-lar)",
      "explanation": "Uzbek has no separate verb 'to be' in the present tense — personal predicative endings attach directly to the noun or adjective, agreeing with the subject. Men talabaman (I am a student), sen talabasan (you are a student), u talaba (he/she is a student — no ending), biz talabamiz (we are students), siz talabasiz (you are a student, formal), ular talaba (they are students).",
      "fact": "Because 3rd person takes no ending at all, a bare sentence like \"U shifokor\" already means the complete \"He/she is a doctor\" — no word is missing, word order alone carries the meaning.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Siz kimsiz?",
          "en": "Who are you? (formal)"
        },
        {
          "sp": "B",
          "native": "Men o'qituvchiman. Ana siz-chi?",
          "en": "I am a teacher. And you?"
        },
        {
          "sp": "A",
          "native": "Men talabaman.",
          "en": "I am a student."
        }
      ]
    },
    "a1-possessive": {
      "title": "Possessive Suffixes",
      "pattern": "[noun] + -im/-ing/-i/-imiz/-ingiz/-i (my/your/his-her/our/your(pl)/their)",
      "explanation": "Uzbek marks possession with a suffix on the noun itself rather than a separate possessive pronoun: kitobim (my book), kitobing (your book), kitobi (his/her book), kitobimiz (our book), kitobingiz (your book, formal/plural), kitobi (their book — same as 3rd singular, context tells them apart).",
      "fact": "The possessive suffix alone can carry a full meaning: onam by itself already means \"my mother\", with no separate word for \"my\" needed at all.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Bu sizning kitobingizmi?",
          "en": "Is this your book?"
        },
        {
          "sp": "B",
          "native": "Ha, bu mening kitobim.",
          "en": "Yes, this is my book."
        }
      ]
    },
    "a1-plural": {
      "title": "Plural: -lar",
      "pattern": "[noun] + -lar",
      "explanation": "Uzbek marks the plural with a single invariant suffix, -lar, added to any noun regardless of its final sound: kitob → kitoblar (books), uy → uylar (houses), bola → bolalar (children).",
      "fact": "Unlike Kazakh or Turkish, standard Uzbek has largely lost vowel harmony, so -lar never changes shape (no -ler variant) — one suffix works for every noun in the language.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Uyda nechta xona bor?",
          "en": "How many rooms are there in the house?"
        },
        {
          "sp": "B",
          "native": "Uyda uchta xona bor.",
          "en": "There are three rooms in the house."
        }
      ]
    },
    "a1-questions": {
      "title": "Yes/No Questions: -mi",
      "pattern": "[word being asked about] + -mi?",
      "explanation": "To turn a statement into a yes/no question, Uzbek attaches the particle -mi directly to the word being questioned (not necessarily the verb): Bu kitobmi? (Is this a book?), Siz talabamisiz? (Are you a student?).",
      "fact": "Moving -mi to a different word in the same sentence shifts what's actually being asked: Siz talabamisiz? asks about being a student, while U sizmisiz? asks whether a specific person is you.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Bu sizning uyingizmi?",
          "en": "Is this your house?"
        },
        {
          "sp": "B",
          "native": "Yo'q, bu mening uyim emas.",
          "en": "No, this is not my house."
        }
      ]
    },
    "a1-cases-1": {
      "title": "Cases I: Dative & Locative (-ga, -da)",
      "pattern": "[noun] + -ga (to/toward) · [noun] + -da (in/at/on)",
      "explanation": "Uzbek marks direction with the dative suffix -ga (maktabga — to school) and location with the locative suffix -da (maktabda — at school). These attach directly to the noun with no separate preposition needed.",
      "fact": "The same suffix pair does double duty for time as well as place: bugun kechqurun-da works for \"this evening\" the same way uy-da works for \"at home\".",
      "dialogue": [
        {
          "sp": "A",
          "native": "Siz qayerga borasiz?",
          "en": "Where are you going?"
        },
        {
          "sp": "B",
          "native": "Men bozorga boraman.",
          "en": "I'm going to the market."
        }
      ]
    },
    "a1-cases-2": {
      "title": "Cases II: Accusative & Ablative (-ni, -dan)",
      "pattern": "[noun] + -ni (direct object) · [noun] + -dan (from/out of)",
      "explanation": "The accusative suffix -ni marks a definite direct object: kitobni o'qiyman (I'm reading the book). The ablative suffix -dan marks origin or source: uydan chiqdim (I left the house / came out of the house).",
      "fact": "Leaving -ni off a direct object is grammatical too, but changes the meaning slightly toward something less specific — kitob o'qiyman (\"I'm reading a book\", general) versus kitobni o'qiyman (\"I'm reading the book\", a specific one).",
      "dialogue": [
        {
          "sp": "A",
          "native": "Siz qayerdansiz?",
          "en": "Where are you from?"
        },
        {
          "sp": "B",
          "native": "Men Toshkentdanman.",
          "en": "I'm from Tashkent."
        }
      ]
    },
    "a1-present": {
      "title": "Present-Future Tense: -(a)di",
      "pattern": "[stem] + -(a)di + person ending",
      "explanation": "Uzbek uses one tense form for both habitual present and future actions: boraman (I go / I will go), borasan, boradi, boramiz, borasiz, boradi(lar). Context makes clear whether it's a habit or a future plan.",
      "fact": "The very same form men boraman can mean either \"I go [there every day]\" or \"I will go [tomorrow]\" — Uzbek doesn't force a speaker to choose between them the way English does.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Ertaga bozorga borasizmi?",
          "en": "Will you go to the market tomorrow?"
        },
        {
          "sp": "B",
          "native": "Ha, ertaga boraman.",
          "en": "Yes, I'll go tomorrow."
        }
      ]
    },
    "a1-past": {
      "title": "Simple Past: -di",
      "pattern": "[stem] + -di + person ending",
      "explanation": "The simple past adds -di (or -ti after a voiceless consonant) directly to the verb stem: bordim (I went), bording, bordi, bordik, bordingiz, bordi(lar).",
      "fact": "The 3rd person past form bordi looks identical whether the subject is singular or plural — u bordi (he/she went) and ular bordi (they went) are told apart only by the pronoun in front.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Kecha qayerga bording?",
          "en": "Where did you go yesterday?"
        },
        {
          "sp": "B",
          "native": "Kecha men bozorga bordim.",
          "en": "Yesterday I went to the market."
        }
      ]
    },
    "a1-negation": {
      "title": "Negation: -ma- and emas",
      "pattern": "verb: [stem] + -ma- + tense · noun/adj: [word] + emas",
      "explanation": "Verbs are negated by inserting -ma- right after the stem and before the tense ending: bormadim (I didn't go), boraman → bormayman (I don't/won't go). Nouns and adjectives, which have no verb to modify, use the separate word emas instead: talaba emasman (I am not a student).",
      "fact": "Because emas is a free-standing word rather than a suffix, it can be repeated on its own as a short \"no, not that\" answer — much like English \"not\" can stand alone in a quick correction.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Siz shifokormisiz?",
          "en": "Are you a doctor?"
        },
        {
          "sp": "B",
          "native": "Yo'q, men shifokor emasman. Men o'qituvchiman.",
          "en": "No, I am not a doctor. I am a teacher."
        }
      ]
    }
  },
