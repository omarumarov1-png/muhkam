{
  "level": "a2",
  "lessons": [
    {
      "number": 34,
      "title": "Conversation: At the Doctor",
      "titleNative": "Suhbat: shifokorda",
      "items": [
        {
          "uz": "Sizni nima bezovta qilyapti?",
          "en": "What's bothering you?"
        },
        {
          "uz": "Boshim og'riyapti va harorat bor.",
          "en": "My head hurts and I have a fever."
        },
        {
          "uz": "Qachondan beri o'zingizni yomon his qilyapsiz?",
          "en": "Since when have you been feeling unwell?"
        },
        {
          "uz": "Ikki kundan beri.",
          "en": "For two days."
        },
        {
          "uz": "Sizga dori yozib beraman.",
          "en": "I'll prescribe you some medicine."
        },
        {
          "uz": "Kuniga necha marta ichishim kerak?",
          "en": "How many times a day should I take it?"
        },
        {
          "uz": "Kuniga uch marta, ovqatdan keyin.",
          "en": "Three times a day, after meals."
        },
        {
          "uz": "Ko'p suv iching va dam oling.",
          "en": "Drink a lot of water and rest."
        },
        {
          "uz": "Rahmat, doktor.",
          "en": "Thank you, doctor."
        },
        {
          "uz": "Bir hafta o'tib yana keling.",
          "en": "Come back again in a week."
        },
        {
          "uz": "Yaxshi bo'lib ketasiz, xavotir olmang.",
          "en": "You'll get better, don't worry."
        },
        {
          "uz": "Sog' bo'ling!",
          "en": "Get well soon!"
        }
      ]
    },
    {
      "number": 35,
      "title": "Conversation: Shopping at the Market",
      "titleNative": "Suhbat: bozorda xarid",
      "items": [
        {
          "uz": "Bu olmalar qancha turadi?",
          "en": "How much do these apples cost?"
        },
        {
          "uz": "Bir kilosi o'n ming so'm.",
          "en": "One kilo is ten thousand som."
        },
        {
          "uz": "Biroz arzonroq qilib bering.",
          "en": "Please give a bit of a discount."
        },
        {
          "uz": "Sizga to'qqiz ming so'mdan beraman.",
          "en": "I'll give it to you for nine thousand."
        },
        {
          "uz": "Ikki kilo olma bering, iltimos.",
          "en": "Please give me two kilos of apples."
        },
        {
          "uz": "Boshqa narsa kerakmi?",
          "en": "Do you need anything else?"
        },
        {
          "uz": "Ha, bir kilo uzum ham bering.",
          "en": "Yes, please give me a kilo of grapes too."
        },
        {
          "uz": "Mana, hammasi tayyor.",
          "en": "Here you go, everything's ready."
        },
        {
          "uz": "Jami qancha bo'ldi?",
          "en": "How much is it altogether?"
        },
        {
          "uz": "Yigirma besh ming so'm bo'ladi.",
          "en": "It comes to twenty-five thousand som."
        },
        {
          "uz": "Mana pulingiz.",
          "en": "Here's your money."
        },
        {
          "uz": "Rahmat, yana keling!",
          "en": "Thank you, come again!"
        }
      ]
    },
    {
      "number": 36,
      "title": "Conversation: Making Plans",
      "titleNative": "Suhbat: reja tuzish",
      "items": [
        {
          "uz": "Dam olish kunlari nima qilmoqchisan?",
          "en": "What do you plan to do on the weekend?"
        },
        {
          "uz": "Aniq bilmayman, sen nima taklif qilasan?",
          "en": "I don't know exactly, what do you suggest?"
        },
        {
          "uz": "Tog'larga borsak, qanday bo'ladi?",
          "en": "How about we go to the mountains?"
        },
        {
          "uz": "Ajoyib fikr! Qachon jo'naymiz?",
          "en": "Great idea! When shall we leave?"
        },
        {
          "uz": "Shanba kuni ertalab jo'naymiz.",
          "en": "We'll leave Saturday morning."
        },
        {
          "uz": "Ovqat va suv olib borishimiz kerak.",
          "en": "We need to bring food and water."
        },
        {
          "uz": "Men mashinani tayyorlab qo'yaman.",
          "en": "I'll get the car ready."
        },
        {
          "uz": "Do'stlarimizni ham taklif qilaylikmi?",
          "en": "Should we invite our friends too?"
        },
        {
          "uz": "Ha, ular ham xursand bo'lishadi.",
          "en": "Yes, they'll be happy too."
        },
        {
          "uz": "Ob-havo qanday bo'lar ekan?",
          "en": "I wonder what the weather will be like."
        },
        {
          "uz": "Bashoratga ko'ra, quyoshli bo'ladi.",
          "en": "According to the forecast, it will be sunny."
        },
        {
          "uz": "Unda hammasi rejadagidek bo'ladi!",
          "en": "Then everything will go as planned!"
        }
      ]
    }
  ]
}
