{
  "level": "a1",
  "lessons": [
    {
      "number": 1,
      "title": "Greetings",
      "titleNative": "Salomlashish",
      "items": [
        {
          "uz": "Salom!",
          "en": "Hi!"
        },
        {
          "uz": "Assalomu alaykum!",
          "en": "Hello! (formal)"
        },
        {
          "uz": "Xayrli tong!",
          "en": "Good morning!"
        },
        {
          "uz": "Xayrli kun!",
          "en": "Good afternoon!"
        },
        {
          "uz": "Xayrli kech!",
          "en": "Good evening!"
        },
        {
          "uz": "Qalaysiz?",
          "en": "How are you? (formal)"
        },
        {
          "uz": "Qalaysan?",
          "en": "How are you? (informal)"
        },
        {
          "uz": "Yaxshiman, rahmat.",
          "en": "I'm fine, thank you."
        },
        {
          "uz": "Rahmat!",
          "en": "Thank you!"
        },
        {
          "uz": "Arzimaydi.",
          "en": "You're welcome."
        },
        {
          "uz": "Xayr!",
          "en": "Bye!"
        },
        {
          "uz": "Ko'rishguncha!",
          "en": "See you later!"
        }
      ]
    },
    {
      "number": 2,
      "title": "Introducing Yourself",
      "titleNative": "O'zingni tanishtirish",
      "items": [
        {
          "uz": "Mening ismim Aziz.",
          "en": "My name is Aziz."
        },
        {
          "uz": "Ismingiz nima?",
          "en": "What is your name? (formal)"
        },
        {
          "uz": "Sizni tanishganimdan xursandman.",
          "en": "Nice to meet you. (formal)"
        },
        {
          "uz": "Men O'zbekistondanman.",
          "en": "I am from Uzbekistan."
        },
        {
          "uz": "Siz qayerdansiz?",
          "en": "Where are you from? (formal)"
        },
        {
          "uz": "Men talabaman.",
          "en": "I am a student."
        },
        {
          "uz": "U o'qituvchi.",
          "en": "He/she is a teacher."
        },
        {
          "uz": "Necha yoshdasiz?",
          "en": "How old are you? (formal)"
        },
        {
          "uz": "Men yigirma yoshdaman.",
          "en": "I am twenty years old."
        },
        {
          "uz": "Kasbingiz nima?",
          "en": "What is your profession?"
        },
        {
          "uz": "Men shifokorman.",
          "en": "I am a doctor."
        },
        {
          "uz": "Bu mening do'stim.",
          "en": "This is my friend."
        }
      ]
    },
    {
      "number": 3,
      "title": "Numbers 1-20",
      "titleNative": "1 dan 20 gacha sonlar",
      "items": [
        {
          "uz": "Menda bitta akam bor.",
          "en": "I have one older brother."
        },
        {
          "uz": "Bu uyda ikkita xona bor.",
          "en": "There are two rooms in this house."
        },
        {
          "uz": "Men uchta kitob sotib oldim.",
          "en": "I bought three books."
        },
        {
          "uz": "Stolda to'rtta olma bor.",
          "en": "There are four apples on the table."
        },
        {
          "uz": "U beshta til biladi.",
          "en": "He/she knows five languages."
        },
        {
          "uz": "Bizda oltita stul bor.",
          "en": "We have six chairs."
        },
        {
          "uz": "Haftada yettita kun bor.",
          "en": "There are seven days in a week."
        },
        {
          "uz": "Men sakkizta imtihon topshirdim.",
          "en": "I took eight exams."
        },
        {
          "uz": "Bog'da to'qqizta daraxt bor.",
          "en": "There are nine trees in the garden."
        },
        {
          "uz": "Men o'nta so'z yodladim.",
          "en": "I memorized ten words."
        },
        {
          "uz": "Bu ish o'n besh daqiqa davom etadi.",
          "en": "This work takes fifteen minutes."
        },
        {
          "uz": "U yigirma yoshda turmushga chiqdi.",
          "en": "She got married at twenty."
        }
      ]
    },
    {
      "number": 4,
      "title": "Family",
      "titleNative": "Oila",
      "items": [
        {
          "uz": "Mening otam muhandis.",
          "en": "My father is an engineer."
        },
        {
          "uz": "Onam uy bekasi.",
          "en": "My mother is a housewife."
        },
        {
          "uz": "Akam armiyada xizmat qilyapti.",
          "en": "My older brother is serving in the army."
        },
        {
          "uz": "Ukam hali maktabga bormaydi.",
          "en": "My younger brother doesn't go to school yet."
        },
        {
          "uz": "Opam turmushga chiqdi.",
          "en": "My older sister got married."
        },
        {
          "uz": "Singlim universitetda o'qiydi.",
          "en": "My younger sister studies at university."
        },
        {
          "uz": "Bizning oilamiz besh kishidan iborat.",
          "en": "Our family consists of five people."
        },
        {
          "uz": "Buvim har kuni bog'da ishlaydi.",
          "en": "My grandmother works in the garden every day."
        },
        {
          "uz": "Buvam gazeta o'qishni yaxshi ko'radi.",
          "en": "My grandfather likes reading the newspaper."
        },
        {
          "uz": "Erim har kuni ishga boradi.",
          "en": "My husband goes to work every day."
        },
        {
          "uz": "Xotinim ajoyib taomlar pishiradi.",
          "en": "My wife cooks wonderful meals."
        },
        {
          "uz": "Bizning bolamiz hali kichkina.",
          "en": "Our child is still little."
        }
      ]
    },
    {
      "number": 5,
      "title": "Colors",
      "titleNative": "Ranglar",
      "items": [
        {
          "uz": "Bu ko'ylak qizil.",
          "en": "This shirt is red."
        },
        {
          "uz": "Osmon bugun ko'k.",
          "en": "The sky is blue today."
        },
        {
          "uz": "Quyosh sariq rangda tasvirlanadi.",
          "en": "The sun is depicted in yellow."
        },
        {
          "uz": "Daraxtlar yozda yashil bo'ladi.",
          "en": "Trees are green in summer."
        },
        {
          "uz": "Qor oq rangda.",
          "en": "Snow is white."
        },
        {
          "uz": "Uning sochlari qora.",
          "en": "Her/his hair is black."
        },
        {
          "uz": "Bu stol jigarrang.",
          "en": "This table is brown."
        },
        {
          "uz": "Qizim pushti rangni yaxshi ko'radi.",
          "en": "My daughter likes pink."
        },
        {
          "uz": "Bu devor kulrang.",
          "en": "This wall is gray."
        },
        {
          "uz": "Kuzda barglar to'q sariq bo'ladi.",
          "en": "In autumn the leaves turn orange."
        },
        {
          "uz": "U binafsha rang libos kiydi.",
          "en": "She wore a purple dress."
        },
        {
          "uz": "Bu uzuk kumush rangda.",
          "en": "This ring is silver-colored."
        }
      ]
    },
    {
      "number": 6,
      "title": "Days & Time",
      "titleNative": "Kunlar va vaqt",
      "items": [
        {
          "uz": "Dushanba kuni ishga boraman.",
          "en": "I go to work on Monday."
        },
        {
          "uz": "Seshanba kuni darslarim ko'p.",
          "en": "I have many classes on Tuesday."
        },
        {
          "uz": "Chorshanba kuni bozorga boramiz.",
          "en": "We go to the market on Wednesday."
        },
        {
          "uz": "Payshanba kuni mehmon kutyapmiz.",
          "en": "We are expecting guests on Thursday."
        },
        {
          "uz": "Juma kuni ishdan erta chiqaman.",
          "en": "I leave work early on Friday."
        },
        {
          "uz": "Shanba kuni dam olaman.",
          "en": "I rest on Saturday."
        },
        {
          "uz": "Yakshanba kuni oilam bilan sayr qilaman.",
          "en": "I go for a walk with my family on Sunday."
        },
        {
          "uz": "Bugun ob-havo juda issiq.",
          "en": "The weather is very hot today."
        },
        {
          "uz": "Ertaga uchrashuvim bor.",
          "en": "I have a meeting tomorrow."
        },
        {
          "uz": "Kecha kinoga bordim.",
          "en": "Yesterday I went to the movies."
        },
        {
          "uz": "Bu hafta juda band bo'ldim.",
          "en": "I was very busy this week."
        },
        {
          "uz": "Har oy oyligimni olaman.",
          "en": "I get my salary every month."
        }
      ]
    },
    {
      "number": 7,
      "title": "Food & Drink",
      "titleNative": "Ovqat va ichimlik",
      "items": [
        {
          "uz": "Ertalab non va choy yeyman.",
          "en": "In the morning I eat bread and drink tea."
        },
        {
          "uz": "Bugun tushlikka osh pishirdik.",
          "en": "Today we cooked plov for lunch."
        },
        {
          "uz": "Men go'shtli taomlarni yaxshi ko'raman.",
          "en": "I like meat dishes."
        },
        {
          "uz": "Bozorda yangi sabzavotlar bor edi.",
          "en": "There were fresh vegetables at the market."
        },
        {
          "uz": "Kechqurun meva yeymiz.",
          "en": "In the evening we eat fruit."
        },
        {
          "uz": "Bu choy juda issiq.",
          "en": "This tea is very hot."
        },
        {
          "uz": "Menga bir stakan suv bering.",
          "en": "Give me a glass of water, please."
        },
        {
          "uz": "Bolalar sut ichishni yaxshi ko'radi.",
          "en": "Children like drinking milk."
        },
        {
          "uz": "Onam tuxumli taom pishirdi.",
          "en": "My mother cooked an egg dish."
        },
        {
          "uz": "Choyga shakar solaymi?",
          "en": "Should I put sugar in the tea?"
        },
        {
          "uz": "Bu taomda tuz kam.",
          "en": "There is little salt in this dish."
        },
        {
          "uz": "Men olma va uzum sotib oldim.",
          "en": "I bought apples and grapes."
        }
      ]
    },
    {
      "number": 8,
      "title": "Daily Life",
      "titleNative": "Kundalik hayot",
      "items": [
        {
          "uz": "Men har kuni ertalab soat oltida turaman.",
          "en": "I wake up at six every morning."
        },
        {
          "uz": "U kechqurun kitob o'qiydi.",
          "en": "He/she reads a book in the evening."
        },
        {
          "uz": "Biz birga ovqatlanamiz.",
          "en": "We eat together."
        },
        {
          "uz": "Bolalar maktabga boradi.",
          "en": "The children go to school."
        },
        {
          "uz": "Men choy ichishni yaxshi ko'raman.",
          "en": "I like to drink tea."
        },
        {
          "uz": "Onam har kuni ovqat pishiradi.",
          "en": "My mother cooks every day."
        },
        {
          "uz": "Dadam ishga mashinada boradi.",
          "en": "My father goes to work by car."
        },
        {
          "uz": "Kechqurun biz televizor ko'ramiz.",
          "en": "In the evening we watch TV."
        },
        {
          "uz": "Men uy vazifamni bajaraman.",
          "en": "I do my homework."
        },
        {
          "uz": "Bozorda meva va sabzavot sotiladi.",
          "en": "Fruits and vegetables are sold at the market."
        },
        {
          "uz": "Bu yerda restoran bormi?",
          "en": "Is there a restaurant here?"
        },
        {
          "uz": "Men suv ichmoqchiman.",
          "en": "I want to drink water."
        }
      ]
    }
  ]
}
