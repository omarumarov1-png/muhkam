{
  "level": "b2plus",
  "lessons": [
    {
      "number": 146,
      "title": "Conversation: Handling a Crisis",
      "titleNative": "Suhbat: inqirozni boshqarish",
      "items": [
        {
          "uz": "Vaziyat qanchalik jiddiy?",
          "en": "How serious is the situation?"
        },
        {
          "uz": "Juda jiddiy, tezkor choralar ko'rishimiz kerak.",
          "en": "Very serious, we need to take quick measures."
        },
        {
          "uz": "Birinchi navbatda nima qilishimiz kerak?",
          "en": "What should we do first?"
        },
        {
          "uz": "Jamoani yig'ib, vaziyatni tushuntirishimiz lozim.",
          "en": "We need to gather the team and explain the situation."
        },
        {
          "uz": "Mijozlarga qanday xabar beramiz?",
          "en": "How will we inform the clients?"
        },
        {
          "uz": "Ochiq va rostgo'y bo'lishimiz kerak.",
          "en": "We need to be open and honest."
        },
        {
          "uz": "Bu inqirozdan qanday chiqib ketamiz?",
          "en": "How will we get out of this crisis?"
        },
        {
          "uz": "Birlashib, qadam-baqadam harakat qilsak, chiqamiz.",
          "en": "If we unite and act step by step, we'll get through it."
        },
        {
          "uz": "Xavotir olmang, hammasi yaxshi bo'ladi.",
          "en": "Don't worry, everything will be fine."
        },
        {
          "uz": "Sizning xotirjamligingiz bizga kuch beryapti.",
          "en": "Your composure is giving us strength."
        },
        {
          "uz": "Bu tajribadan saboq olishimiz kerak.",
          "en": "We need to learn a lesson from this experience."
        },
        {
          "uz": "Birgalikda hal qila olmaydigan muammo yo'q.",
          "en": "There's no problem we can't solve together."
        }
      ]
    }
  ]
}
