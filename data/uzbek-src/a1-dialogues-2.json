{
  "level": "a1",
  "lessons": [
    {
      "number": 121,
      "title": "Conversation: At Home",
      "titleNative": "Suhbat: uyda",
      "items": [
        {
          "uz": "Bugun kim ovqat pishiradi?",
          "en": "Who's cooking today?"
        },
        {
          "uz": "Men pishiraman, sen dam ol.",
          "en": "I'll cook, you rest."
        },
        {
          "uz": "Uyni tozalashga yordam bera olasanmi?",
          "en": "Can you help clean the house?"
        },
        {
          "uz": "Albatta, hoziroq boshlayman.",
          "en": "Of course, I'll start right now."
        },
        {
          "uz": "Bolalar qayerda o'ynayapti?",
          "en": "Where are the children playing?"
        },
        {
          "uz": "Ular hovlida.",
          "en": "They're in the yard."
        },
        {
          "uz": "Kechqurun nima qilamiz?",
          "en": "What shall we do in the evening?"
        },
        {
          "uz": "Birga kino ko'raylik.",
          "en": "Let's watch a movie together."
        },
        {
          "uz": "Choy tayyormi?",
          "en": "Is the tea ready?"
        },
        {
          "uz": "Ha, hozir olib kelaman.",
          "en": "Yes, I'll bring it now."
        },
        {
          "uz": "Uyimiz juda qulay.",
          "en": "Our house is very comfortable."
        },
        {
          "uz": "Bu yerda o'zimni juda yaxshi his qilaman.",
          "en": "I feel very good here."
        }
      ]
    }
  ]
}
