 "level": "a1",
 "grammarTopics": {
  "a1-greetings": {
   "title": "Greetings: Hala and Marhaba",
   "pattern": "هلا / مرحبا / السلام عليكم",
   "explanation": "Emirati Arabic has several everyday greetings. \"هلا\" (hala) and \"مرحبا\" (marhaba) are casual hellos used constantly in daily life. \"السلام عليكم\" (as-salaamu alaykum, \"peace be upon you\") is the more formal/traditional Islamic greeting, answered with \"وعليكم السلام\" (wa alaykum as-salaam). \"شلونك؟\" (shlonak?) asks \"how are you?\" and is typically answered \"زين، الحمد لله\" (zayn, alhamdulillah — \"good, thank God\").",
   "fact": "Emirati greetings often stack: a full exchange might go \"السلام عليكم\" → \"وعليكم السلام\" → \"شلونك؟\" → \"زين، الحمد لله. وانت؟\" — layering several greeting formulas together is completely normal and expected, not redundant.",
   "dialogue": [
    {
     "sp": "A",
     "native": "السلام عليكم! شلونك اليوم؟",
     "en": "Peace be upon you! How are you today?"
    },
    {
     "sp": "B",
     "native": "وعليكم السلام. زين، الحمد لله. وانت؟",
     "en": "And peace be upon you. Good, thank God. And you?"
    }
   ]
  },
  "a1-present-shirib": {
   "title": "Present Tense: I Drink, You Drink...",
   "pattern": "أ- / تِ- / تِ-...ين / يِ- / تِ- / نِ- / تِ-...ون / يِ-...ون",
   "explanation": "Emirati present-tense verbs take a prefix (and sometimes a suffix) that shows who's doing the action: أشرب (ashrab, \"I drink\"), تشرب (tishrab, \"you-m drink\"), تشربي (tishrabi, \"you-f drink\"), يشرب (yishrab, \"he drinks\"), تشرب (tishrab, \"she drinks\", same as you-m), نشرب (nishrab, \"we drink\"), تشربون (tishrabuun, \"you-all drink\"), يشربون (yishrabuun, \"they drink\").",
   "fact": "Notice \"you-m drink\" (تشرب tishrab) and \"she drinks\" (تشرب tishrab) look identical in writing and sound — context (who's being talked about) is what tells them apart, exactly the way English \"read\" sounds the same in present tense regardless of subject.",
   "dialogue": [
    {
     "sp": "A",
     "native": "شنو تشرب الحين؟",
     "en": "What are you drinking now?"
    },
    {
     "sp": "B",
     "native": "أشرب قهوة الحين وبعدين شاي",
     "en": "I'm drinking coffee now and tea later"
    }
   ]
  },
  "a1-negation": {
   "title": "Negation: Ma and Mub",
   "pattern": "ما + فعل (verb) / مب + اسم (noun/adjective)",
   "explanation": "To say a verb didn't/doesn't happen, put ما (ma) right before it: ما أبغى (ma abgha, \"I don't want\"). To negate a nominal sentence (no verb, just \"X is Y\"), Emirati uses مب (mub) instead: أنا مب تعبان (ana mub ta3baan, \"I'm not tired\").",
   "fact": "Getting ما and مب mixed up is one of the most common learner mistakes — remember the split by what follows: ما goes with an action (a verb), مب goes with a description (an adjective or noun after a pronoun).",
   "dialogue": [
    {
     "sp": "A",
     "native": "أنت تعبان اليوم؟",
     "en": "Are you tired today?"
    },
    {
     "sp": "B",
     "native": "لا، أنا مب تعبان، أنا مبسوط",
     "en": "No, I'm not tired, I'm happy"
    }
   ]
  }
 },
