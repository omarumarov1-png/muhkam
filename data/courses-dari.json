    "grammarTopics": {
      "greetings-copula": {
        "title": "Greeting Someone and Saying \"I am...\"",
        "pattern": "[Subject] + [adjective] + هستم/هستی/است/هستیم/هستید/هستند",
        "explanation": "Dari's \"to be\" verb (بودن) comes AFTER the word it describes, unlike English \"I am good\" -> \"من خوب هستم\" is literally \"I good am.\" Each person has its own ending: هستم (I am), هستی (you are, one friend), است (he/she/it is), هستیم (we are), هستید (you are, formal or more than one person), هستند (they are). This copula is often shortened to -am/-i/-ast/-im/-id/-and in fast speech, but the full forms here are always correct and are what you will see written.",
        "fact": "شما (shomā) works as both a polite \"you\" for one person and the plain \"you\" for a group -- Dari does not force a separate plural pronoun the way English needs \"you all.\"",
        "dialogue": [
          {
            "native": "سلام، شما چطور هستید؟",
            "en": "Hello, how are you?"
          },
          {
            "native": "من خوب هستم، تشکر. تو چطور هستی؟",
            "en": "I am good, thank you. How are you?"
          },
          {
            "native": "من هم خوب هستم.",
            "en": "I am also good."
          }
        ]
      }
    },
