      "number": 15,
      "title": "Conversation: Talking About Family",
      "titleNative": "Къамел: доьзал хиларах лаьцна",
      "items": [
        {
          "ce": "Хьан машина хаза ю!",
          "en": "Your car is beautiful!"
        },
        {
          "ce": "Баркалла, амма деза ю.",
          "en": "Thank you, but it's heavy."
        },
        {
          "ce": "Ахьмадан машина хазах ю.",
          "en": "Ahmad's car is prettier."
        },
        {
          "ce": "Хьан ваша дика вуй?",
          "en": "Is your brother well?"
        },
        {
          "ce": "Иза дика ву, баркалла.",
          "en": "He is well, thank you."
        },
        {
          "ce": "Цунна шен йиша йеза.",
          "en": "He loves his own sister."
        },
        {
          "ce": "Тхан да дика ву.",
          "en": "Our father is well."
        },
        {
          "ce": "Дала реза хуьлда хьуна!",
          "en": "Thank you very much!"
        }
      ]
    }
  ]
