      "number": 19,
      "title": "Conversation: At Home",
      "titleNative": "Къамел: цIахь",
      "items": [
        {
          "ce": "Хьан цӀе хӀун ю?",
          "en": "What is your name?"
        },
        {
          "ce": "Сан цӀе Ахьмад ю.",
          "en": "My name is Ahmad."
        },
        {
          "ce": "Иза цӀахь ву.",
          "en": "He is at home."
        },
        {
          "ce": "Суна лаьмнаш хазахета.",
          "en": "I like mountains."
        },
        {
          "ce": "Кху чохь кхо кӀант ву.",
          "en": "There are three boys in this room."
        },
        {
          "ce": "Суна бепиг дар дукха деза.",
          "en": "I really like making bread."
        },
        {
          "ce": "Дала реза хуьлда хьуна!",
          "en": "Thank you very much!"
        }
      ]
    }
  ]
