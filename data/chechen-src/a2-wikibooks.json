{
  "level": "a2",
  "lessons": [
    {
      "number": 48,
      "title": "Extended Greetings & Courtesy",
      "titleNative": "ДукхагӀа маршалла а, инзаре а",
      "items": [
        {
          "ce": "Ӏуьйре дика йойла.",
          "en": "Good morning."
        },
        {
          "ce": "Де дика дойла.",
          "en": "Good afternoon."
        },
        {
          "ce": "Суьйре дика йойла.",
          "en": "Good evening."
        },
        {
          "ce": "Буьйса декъал йогӀийла.",
          "en": "Good night."
        },
        {
          "ce": "Девзина хаза хета.",
          "en": "Nice to meet you."
        },
        {
          "ce": "Массарна а.",
          "en": "You're welcome."
        },
        {
          "ce": "Бехк ма биллахь.",
          "en": "Excuse me."
        },
        {
          "ce": "Муха ду гӀуллакхаш?",
          "en": "How are you? (lit. how are affairs?)"
        },
        {
          "ce": "Дика ду, баркалла.",
          "en": "Fine, thanks."
        },
        {
          "ce": "Со кхета.",
          "en": "I understand."
        },
        {
          "ce": "Со ца кхета.",
          "en": "I don't understand."
        },
        {
          "ce": "Хила тарло.",
          "en": "Maybe."
        }
      ]
    },
    {
      "number": 49,
      "title": "Extended Family",
      "titleNative": "ДукхагӀа доьзал",
      "items": [
        {
          "ce": "Доьзал.",
          "en": "Family."
        },
        {
          "ce": "Со цхьа адам ву.",
          "en": "I am one person."
        },
        {
          "ce": "Тхан цхьа жима бер ву.",
          "en": "We have one baby."
        },
        {
          "ce": "Сан неца ю.",
          "en": "I have an aunt (mother's sister)."
        },
        {
          "ce": "Сан шича ву.",
          "en": "I have a cousin."
        },
        {
          "ce": "Сан дада ву.",
          "en": "I have a paternal grandfather."
        },
        {
          "ce": "Сан ненан да ву.",
          "en": "I have a maternal grandfather."
        },
        {
          "ce": "Сан де нана ю.",
          "en": "I have a paternal grandmother."
        },
        {
          "ce": "Сан ненан нана ю.",
          "en": "I have a maternal grandmother."
        },
        {
          "ce": "Сан майра ву.",
          "en": "I have a husband."
        },
        {
          "ce": "Сан зуда ю.",
          "en": "I have a wife."
        }
      ]
    }
  ]
}
