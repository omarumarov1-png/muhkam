  "lessons": [
    {
      "number": 21,
      "title": "Getting Around",
      "titleNative": "سفر",
      "items": [
        { "pashto": "زه موټر لرم.", "en": "I have a car." },
        { "pashto": "دا الوتکه ده.", "en": "This is an airplane." },
        { "pashto": "زما موټر لوی دی.", "en": "My car is big." },
        { "pashto": "زه ښار ته ځم.", "en": "I go to the city." },
        { "pashto": "دا لار ده.", "en": "This is a road." },
        { "pashto": "زه کور ته ځم.", "en": "I go home." },
        { "pashto": "ته چېرته ځې؟", "en": "Where do you go?" }
      ]
    },
    {
      "number": 22,
      "title": "Near and Far",
      "titleNative": "نږدې او لرې",
      "items": [
        { "pashto": "زموږ کور نږدې دی.", "en": "Our house is near." },
        { "pashto": "ښوونځی لرې دی.", "en": "The school is far." },
        { "pashto": "بازار نږدې دی.", "en": "The market is near." },
        { "pashto": "دا ښار لرې دی.", "en": "This city is far." },
        { "pashto": "زما کور ښوونځي ته نږدې دی.", "en": "My house is near the school." },
        { "pashto": "دا لرې دی؟", "en": "Is this far?" },
        { "pashto": "کوم ښار نږدې دی؟", "en": "Which city is near?" }
      ]
    },
    {
      "number": 23,
      "title": "Big and Small",
      "titleNative": "لوی او کوچنی",
      "items": [
        { "pashto": "زموږ کور لوی دی.", "en": "Our house is big." },
        { "pashto": "دا کوټه کوچنۍ ده.", "en": "This room is small." },
        { "pashto": "زما کتاب کوچنی دی.", "en": "My book is small." },
        { "pashto": "دا ماشوم کوچنی دی.", "en": "This child is small." },
        { "pashto": "زموږ ښار لوی دی.", "en": "Our city is big." },
        { "pashto": "دا مڼه کوچنۍ ده.", "en": "This apple is small." },
        { "pashto": "دا لوی دی يا کوچنی؟", "en": "Is this big or small?" }
      ]
    },
    {
      "number": 24,
      "title": "Extended Family",
      "titleNative": "د کورنۍ نور غړي",
      "items": [
        { "pashto": "دا زما نیکه دی.", "en": "This is my grandfather." },
        { "pashto": "دا زما انا ده.", "en": "This is my grandmother." },
        { "pashto": "دا زما ترور ده.", "en": "This is my aunt." },
        { "pashto": "دا زما ماما دی.", "en": "This is my maternal uncle." },
        { "pashto": "دا زما کاکا دی.", "en": "This is my paternal uncle." },
        { "pashto": "زما نیکه ښه دی.", "en": "My grandfather is good." },
        { "pashto": "ستا انا څنګه ده؟", "en": "How is your grandmother?" }
      ]
    },
    {
      "number": 25,
      "title": "Telling Time",
      "titleNative": "وخت",
      "items": [
        { "pashto": "اوس کوم وخت دی؟", "en": "What time is it now?" },
        { "pashto": "دا یو ساعت دی.", "en": "This is one hour." },
        { "pashto": "زه لس دقیقې لرم.", "en": "I have ten minutes." },
        { "pashto": "زه اوس وخت لرم.", "en": "I have time now." },
        { "pashto": "ته کله ځې؟", "en": "When do you go?" },
        { "pashto": "زه سبا ځم.", "en": "I go tomorrow." },
        { "pashto": "اوس دقیقه ده يا ساعت؟", "en": "Is it a minute or an hour now?" }
      ]
    },
    {
      "number": 26,
      "title": "At the Market",
      "titleNative": "په بازار کې",
      "items": [
        { "pashto": "زه بازار ته ځم.", "en": "I go to the market." },
        { "pashto": "زما پیسې دي.", "en": "I have money." },
        { "pashto": "دا بازار لوی دی.", "en": "This market is big." },
        { "pashto": "زه مڼه غواړم.", "en": "I want an apple." },
        { "pashto": "بازار نږدې دی که لرې؟", "en": "Is the market near or far?" },
        { "pashto": "زه ډوډۍ غواړم.", "en": "I want food." },
        { "pashto": "ته پیسې لرې؟", "en": "Do you have money?" }
      ]
    },
    {
      "number": 27,
      "title": "My Day",
      "titleNative": "زما ورځ",
      "items": [
        { "pashto": "زه هر ورځ ښوونځي ته ځم.", "en": "I go to school every day." },
        { "pashto": "زه کتاب لولم.", "en": "I read a book." },
        { "pashto": "زه ډوډۍ خورم.", "en": "I eat food." },
        { "pashto": "زه کور ته ځم.", "en": "I go home." },
        { "pashto": "اوس زه وخت لرم.", "en": "Now I have time." },
        { "pashto": "زما ورځ ښه ده.", "en": "My day is good." },
        { "pashto": "ستا ورځ څنګه ده؟", "en": "How is your day?" }
      ]
    },
    {
      "number": 28,
      "title": "Review: Family and People",
      "titleNative": "بیاکتنه: کورنۍ",
      "items": [
        { "pashto": "دا زما نیکه او انا دي.", "en": "These are my grandfather and grandmother." },
        { "pashto": "زما ترور ښوونکې ده.", "en": "My aunt is a teacher." },
        { "pashto": "زما کاکا ډاکټر دی.", "en": "My paternal uncle is a doctor." },
        { "pashto": "زما ماما لوی دی.", "en": "My maternal uncle is big." },
        { "pashto": "ستا ملګری څوک دی؟", "en": "Who is your friend?" },
        { "pashto": "دا ماشوم زما دی.", "en": "This child is mine." },
        { "pashto": "زما کورنۍ ښه ده.", "en": "My family is good." }
      ]
    },
    {
      "number": 29,
      "title": "Review: Places and Objects",
      "titleNative": "بیاکتنه: ځایونه",
      "items": [
        { "pashto": "زموږ کور ښار کې دی.", "en": "Our house is in the city." },
        { "pashto": "ښوونځی زموږ کور ته نږدې دی.", "en": "The school is near our house." },
        { "pashto": "بازار لرې دی.", "en": "The market is far." },
        { "pashto": "زما موټر کوچنی دی.", "en": "My car is small." },
        { "pashto": "دا کتاب زما دی.", "en": "This book is mine." },
        { "pashto": "زما کوټه کې یو کتاب دی.", "en": "There is a book in my room." },
        { "pashto": "دا کوم ځای دی؟", "en": "What place is this?" }
      ]
    },
    {
      "number": 30,
      "title": "Where Are You Going?",
      "titleNative": "چېرته ځې؟",
      "items": [
        { "pashto": "زه ښوونځي ته ځم.", "en": "I go to school." },
        { "pashto": "ته بازار ته ځې؟", "en": "Do you go to the market?" },
        { "pashto": "موږ کور ته ځو.", "en": "We go home." },
        { "pashto": "هغوی ښار ته ځي.", "en": "They go to the city." },
        { "pashto": "زه سبا ښوونځي ته نه ځم.", "en": "I do not go to school tomorrow." },
        { "pashto": "ته کله بازار ته ځې؟", "en": "When do you go to the market?" },
        { "pashto": "موږ اوس کور ته ځو.", "en": "We go home now." }
      ]
    }
