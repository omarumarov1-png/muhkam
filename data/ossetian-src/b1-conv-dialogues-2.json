    "b1-conv-possession": {
      "title": "Conversation: Do You Have It?",
      "pattern": "[dative] ис [thing]? (do ~ have ~?)",
      "explanation": "\"Мӕнмӕ ис X\" (lit. \"to-me is X\") is a common way Ossetian expresses \"I have X\" -- built from attested sentences here, not asserted as a full productive rule, since the exact case-marking system behind it isn't independently confirmed yet.",
      "fact": "This \"to-me is X\" possession pattern is shared by many languages across the Caucasus region, not unique to Ossetian.",
      "dialogue": [
        {
          "sp": "A",
          "native": "Фынг уӕм ис?",
          "en": "Do you have a table?"
        },
        {
          "sp": "B",
          "native": "Мӕнмӕ ис ручка.",
          "en": "I have a pen."
        },
        {
          "sp": "A",
          "native": "Мӕнӕн ис бынӕт?",
          "en": "Is there room for me?"
        },
        {
          "sp": "B",
          "native": "О, хорз.",
          "en": "Yes, okay."
        }
      ]
    }
  },
