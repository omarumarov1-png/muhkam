 "اللَّهُمَّ إِنِّي أَسْأَلُكَ الِاسْتِمْسَاكَ بِسُنَّتِهِ وَأَعُوذُ بِكَ مِنَ الِانْحِرَافِ عَمَّا جَاءَ بِهِ.": {
  "file": "dal_69b20c0aa7338703.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ مَا سَأَلَكَ مِنْهُ سَيِّدُنَا مُحَمَّدٌ نَبِيُّكَ وَرَسُولُكَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا اسْتَعَاذَكَ مِنْهُ سَيِّدُنَا مُحَمَّدٌ نَبِيُّكَ وَرَسُولُكَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.": {
  "file": "dal_0ce055194e63f3a5.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ اعْصِمْنِي مِنْ شَرِّ الْفِتَنِ وَعَافِنِي مِنْ جَمِيعِ الْمِحَنِ وَأَصْلِحْ مِنِّي مَا ظَهَرَ وَمَا بَطَنَ وَنَقِّ قَلْبِي مِنَ الْحِقْدِ وَالْحَسَدِ وَلَا تَجْعَلْ عَلَيَّ طَبَاعَةً لِأَحَدٍ.": {
  "file": "dal_6b09eaeab29c9c84.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ إِنِّي أَسْأَلُكَ الْأَخْذَ بِأَحْسَنِ مَا تَعْلَمُ وَتَرْكَ السَّيِّئِ مَا تَعْلَمُ، وَأَسْأَلُكَ التَّكَفُّلَ بِالرِّزْقِ وَالزُّهْدَ فِي الْكَفَافِ، وَالْمَخْرَجَ بِالْبَيَانِ مِنْ كُلِّ شُبْهَةٍ، وَالْفَلَجَ بِالصَّوَابِ فِي كُلِّ حُجَّةٍ، وَالْعَدْلَ فِي الْغَضَبِ وَالرِّضَا، وَالتَّسْلِيمَ لِمَا يَجْرِي بِهِ الْقَضَاءُ، وَالِاقْتِصَادَ فِي الْفَقْرِ وَالْغِنَى، وَالتَّوَاضُعَ فِي الْقَوْلِ وَالْفِعْلِ، وَالصِّدْقَ فِي الْجِدِّ وَالْهَزْلِ.": {
  "file": "dal_b0049a8eb670b1f3.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ إِنَّ لِي ذُنُوبًا فِيمَا بَيْنِي وَبَيْنَكَ وَذُنُوبًا فِيمَا بَيْنِي وَبَيْنَ خَلْقِكَ.": {
  "file": "dal_db8875db3abcda34.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ مَا كَانَ لَكَ مِنْهَا فَاغْفِرْهُ، وَمَا كَانَ مِنْهَا لِخَلْقِكَ فَتَحَمَّلْهُ عَنِّي وَأَغْنِنِي بِفَضْلِكَ، إِنَّكَ وَاسِعُ الْمَغْفِرَةِ.": {
  "file": "dal_e479358315712a18.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ نَوِّرْ بِالْعِلْمِ قَلْبِي، وَاسْتَعْمِلْ بِطَاعَتِكَ بَدَنِي، وَخَلِّصْ مِنَ الْفِتَنِ سِرِّي، وَاشْغَلْ بِالِاعْتِبَارِ فِكْرِي، وَقِنِي شَرَّ وَسَاوِسِ الشَّيْطَانِ، وَأَجِرْنِي مِنْهُ يَا رَحْمَٰنُ حَتَّى لَا يَكُونَ لَهُ عَلَيَّ سُلْطَانٌ.": {
  "file": "dal_2e87f1ffd046b4d1.mp3",
  "voice": "designed-ar-dalail-reciter"
