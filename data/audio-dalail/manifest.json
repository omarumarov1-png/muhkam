 "اللَّهُمَّ صَلِّ عَلَى مَنْ فَاضَتْ مِنْ نُورِهِ جَمِيعُ الْأَنْوَارِ.": {
  "file": "dal_5e8055b011af8433.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ بِالصَّلَاةِ عَلَيْهِ تُحَطُّ الْأَوْزَارُ.": {
  "file": "dal_7ac7647e505d1e25.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ بِالصَّلَاةِ عَلَيْهِ تُنَالُ مَنَازِلُ الْأَبْرَارِ.": {
  "file": "dal_e4d68f1353cd4136.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ بِالصَّلَاةِ عَلَيْهِ يُرْحَمُ الْكِبَارُ وَالصِّغَارُ.": {
  "file": "dal_d1e12d4d1901ac4e.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ بِالصَّلَاةِ عَلَيْهِ نَتَنَعَّمُ فِي هَذِهِ الدَّارِ وَفِي تِلْكَ الدَّارِ.": {
  "file": "dal_1e26afcc551ff59d.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ بِالصَّلَاةِ عَلَيْهِ تُنَالُ رَحْمَةُ الْعَزِيزِ الْغَفَّارِ.": {
  "file": "dal_a62ee117399405f9.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى الْمَنْصُورِ الْمُؤَيَّدِ.": {
  "file": "dal_3e035225e3faf08b.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى الْمُخْتَارِ الْمُمَجَّدِ.": {
  "file": "dal_ea978a6979f27453.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا وَمَوْلَانَا مُحَمَّدٍ.": {
  "file": "dal_e60a3b1648cd3d4c.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى مَنْ كَانَ إِذَا مَشَى فِي الْبَرِّ الْأَقْفَارِ تَعَلَّقَتِ الْوُحُوشُ بِأَذْيَالِهِ.": {
  "file": "dal_7038538f9b61a20b.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "صَلَّى اللَّهُ عَلَيْهِ وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا، وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ.": {
  "file": "dal_b57739c92deb788b.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْفَقْرِ إِلَّا إِلَيْكَ، وَمِنَ الذُّلِّ إِلَّا لَكَ، وَمِنَ الْخَوْفِ إِلَّا مِنْكَ.": {
  "file": "dal_84c921e8e4a642f2.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَأَعُوذُ بِكَ أَنْ أَقُولَ زُورًا، أَوْ أَغْشَى فُجُورًا، أَوْ أَكُونَ بِكَ مَغْرُورًا.": {
  "file": "dal_5b0edd62271debcb.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَأَعُوذُ بِكَ مِنْ شَمَاتَةِ الْأَعْدَاءِ، وَذُلِّ الدَّيْنِ، وَخَيْبَةِ الرَّجَاءِ، وَزَوَالِ النِّعْمَةِ، وَفُجَاءَةِ النِّقْمَةِ.": {
  "file": "dal_83f22270a7940435.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ وَسَلِّمْ عَلَيْهِ وَاجْزِهِ عَنَّا مَا هُوَ أَهْلُهُ، حَبِيبُكَ. (ثَلَاثًا)": {
  "file": "dal_79fdc6729ce52b64.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا إِبْرَاهِيمَ وَسَلِّمْ عَلَيْهِ وَاجْزِهِ عَنَّا مَا هُوَ أَهْلُهُ، خَلِيلُكَ. (ثَلَاثًا)": {
  "file": "dal_8ac6cb54658c7cce.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِ سَيِّدِنَا مُحَمَّدٍ كَمَا صَلَّيْتَ وَرَحِمْتَ وَبَارَكْتَ عَلَى سَيِّدِنَا إِبْرَاهِيمَ فِي الْعَالَمِينَ، إِنَّكَ حَمِيدٌ مَجِيدٌ، عَدَدَ خَلْقِكَ وَرِضَا نَفْسِكَ وَزِنَةَ عَرْشِكَ وَمِدَادَ كَلِمَاتِكَ.": {
  "file": "dal_545b7bc4d246a3a3.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ مَنْ صَلَّى عَلَيْهِ، وَعَدَدَ مَنْ لَمْ يُصَلِّ عَلَيْهِ، وَعَدَدَ مَا صُلِّيَ عَلَيْهِ، وَأَضْعَافَ مَا صُلِّيَ عَلَيْهِ، كَمَا هُوَ أَهْلُهُ، وَكَمَا تُحِبُّ وَتَرْضَاهُ لَهُ.": {
  "file": "dal_199c6eb9a91a1bf4.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا وَمَوْلَانَا مُحَمَّدٍ عَدَدَ مَا أَحَاطَ بِهِ عِلْمُكَ، وَعَدَدَ مَا أَحْصَاهُ كِتَابُكَ، وَعَدَدَ مَا نَفَذَتْ بِهِ قُدْرَتُكَ، وَعَدَدَ مَا خَصَّصَتْهُ إِرَادَتُكَ، وَعَدَدَ مَا تَوَجَّهَ إِلَيْهِ أَمْرُكَ وَنَهْيُكَ، وَعَدَدَ مَا وَسِعَهُ سَمْعُكَ، وَعَدَدَ مَا أَحَاطَ بِهِ بَصَرُكَ، وَعَدَدَ مَا ذَكَرَهُ الذَّاكِرُونَ، وَعَدَدَ مَا غَفَلَ عَنْ ذِكْرِهِ الْغَافِلُونَ.": {
  "file": "dal_feb24447986b7ab1.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَصَلِّ عَلَيْهِ عَدَدَ قَطْرِ الْأَمْطَارِ، وَعَدَدَ أَوْرَاقِ الْأَشْجَارِ، وَعَدَدَ دَوَابِّ الْقِفَارِ، وَعَدَدَ دَوَابِّ الْبِحَارِ، وَعَدَدَ مِيَاهِ الْبِحَارِ، وَعَدَدَ مَا أَظْلَمَ عَلَيْهِ اللَّيْلُ وَأَضَاءَ عَلَيْهِ النَّهَارُ، بِالْغُدُوِّ وَالْآصَالِ، وَعَدَدَ الرِّمَالِ، وَعَدَدَ النِّسَاءِ وَالرِّجَالِ، وَرِضَا نَفْسِكَ، وَمِدَادَ كَلِمَاتِكَ، وَمِلْءَ سَمَاوَاتِكَ وَأَرْضِكَ، وَزِنَةَ عَرْشِكَ، وَعَدَدَ مَخْلُوقَاتِكَ، أَفْضَلَ صَلَوَاتِكَ.": {
  "file": "dal_171e2fede14cf2a5.mp3",
  "voice": "designed-ar-dalail-reciter"
 }
}