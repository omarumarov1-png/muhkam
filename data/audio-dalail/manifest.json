 "اللَّهُمَّ تَقَبَّلْ شَفَاعَةَ سَيِّدِنَا مُحَمَّدٍ الْكُبْرَى، وَارْفَعْ دَرَجَتَهُ الْعُلْيَا، وَآتِهِ سُؤْلَهُ فِي الْآخِرَةِ وَالْأُولَى، كَمَا آتَيْتَ سَيِّدَنَا إِبْرَاهِيمَ وَسَيِّدَنَا مُوسَى.": {
  "file": "dal_7295bb64d2ed4c1d.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِ سَيِّدِنَا مُحَمَّدٍ كَمَا صَلَّيْتَ عَلَى سَيِّدِنَا إِبْرَاهِيمَ وَعَلَى آلِ سَيِّدِنَا إِبْرَاهِيمَ، وَبَارِكْ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِ سَيِّدِنَا مُحَمَّدٍ كَمَا بَارَكْتَ عَلَى سَيِّدِنَا إِبْرَاهِيمَ وَعَلَى آلِ سَيِّدِنَا إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ.": {
  "file": "dal_ac0865775da0c008.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَى سَيِّدِنَا مُحَمَّدٍ نَبِيِّكَ وَرَسُولِكَ.": {
  "file": "dal_5af630738e5b8217.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَسَيِّدِنَا إِبْرَاهِيمَ خَلِيلِكَ وَصَفِيِّكَ، وَسَيِّدِنَا مُوسَى كَلِيمِكَ وَنَجِيِّكَ.": {
  "file": "dal_9b4158f0bcd4ea5f.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَسَيِّدِنَا عِيسَى رُوحِكَ وَكَلِمَتِكَ، وَعَلَى جَمِيعِ مَلَائِكَتِكَ وَرُسُلِكَ وَأَنْبِيَائِكَ وَخِيَرَتِكَ مِنْ خَلْقِكَ وَأَصْفِيَائِكَ وَخَاصَّتِكَ وَأَوْلِيَائِكَ مِنْ أَهْلِ أَرْضِكَ وَسَمَائِكَ.": {
  "file": "dal_ae2e1b54706b8cdc.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ خَلْقِهِ وَرِضَا نَفْسِهِ وَمِدَادَ كَلِمَاتِهِ وَكَمَا هُوَ أَهْلُهُ، وَكُلَّمَا ذَكَرَهُ الذَّاكِرُونَ وَغَفَلَ عَنْ ذِكْرِهِ الْغَافِلُونَ، وَعَلَى أَهْلِ بَيْتِهِ وَعِتْرَتِهِ الطَّاهِرِينَ وَسَلَّمَ تَسْلِيمًا.": {
  "file": "dal_6f11c40dbf32c70b.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى أَزْوَاجِهِ وَذُرِّيَّتِهِ وَعَلَى جَمِيعِ النَّبِيِّينَ وَالْمُرْسَلِينَ وَالْمَلَائِكَةِ الْمُقَرَّبِينَ وَجَمِيعِ عِبَادِ اللَّهِ الصَّالِحِينَ، عَدَدَ مَا أَمْطَرَتِ السَّمَاءُ مُنْذُ بَنَيْتَهَا، وَصَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ مَا أَنْبَتَتِ الْأَرْضُ مُنْذُ دَحَوْتَهَا.": {
  "file": "dal_e4ddeda01516a65d.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَصَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ النُّجُومِ فِي السَّمَاءِ فَإِنَّكَ أَحْصَيْتَهَا.": {
  "file": "dal_d9261335105f8533.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَصَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ مَا تَنَفَّسَتِ الْأَرْوَاحُ مُنْذُ خَلَقْتَهَا.": {
  "file": "dal_f38e43b2cc8bccb0.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "وَصَلِّ عَلَى سَيِّدِنَا مُحَمَّدٍ عَدَدَ مَا خَلَقْتَ وَمَا تَخْلُقُ وَمَا أَحَاطَ بِهِ عِلْمُكَ وَأَضْعَافَ ذَلِكَ.": {
  "file": "dal_973db14e73ec1a10.mp3",
  "voice": "designed-ar-dalail-reciter"
 },
 "اللَّهُمَّ صَلِّ عَلَيْهِمْ عَدَدَ خَلْقِكَ وَرِضَا نَفْسِكَ وَزِنَةَ عَرْشِكَ وَمِدَادَ كَلِمَاتِكَ وَمَبْلَغَ عِلْمِكَ وَآيَاتِكَ.": {
  "file": "dal_28e3af3579ff9a68.mp3",
  "voice": "designed-ar-dalail-reciter"
