      "title": "Asking for Advice",
      "titleNative": "خواستن نصیحت",
      "topicId": "past-tense",
      "items": [
        { "dari": "من از پدرم نصیحت خواستم.", "en": "I asked my father for advice.", "translit": "Man az pedaram nasihat khwāstam." },
        { "dari": "چه نصیحتی برای من دارید؟", "en": "What advice do you have for me?", "translit": "Che nasihati barāy-e man dārid?" },
        { "dari": "من نمی‌دانستم چه کنم.", "en": "I didn't know what to do.", "translit": "Man nemidānestam che konam." },
        { "dari": "از دوستم کمک خواستم.", "en": "I asked my friend for help.", "translit": "Az dostam komak khwāstam." },
        { "dari": "او به من نصیحت خوبی داد.", "en": "He/She gave me good advice.", "translit": "U ba man nasihat-e khubi dād." },
        { "dari": "همیشه از بزرگان نصیحت می‌خواهم.", "en": "I always ask advice from elders.", "translit": "Hamisha az bozorgān nasihat mikhāham." },
        { "dari": "نصیحت او به من کمک کرد.", "en": "His/Her advice helped me.", "translit": "Nasihat-e u ba man komak kard." }
      ]
    },
