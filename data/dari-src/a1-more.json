  "grammarTopics": {
    "adjectives-order": {
      "title": "Describing Things: Adjective After the Noun",
      "pattern": "[noun] + ی + [adjective]",
      "explanation": "In Dari, the describing word comes AFTER the noun, joined by an unwritten -e/-ye sound (the ezafe): خانهٔ بزرگ (khāna-ye bozorg) is literally \"house-of big,\" meaning \"a/the big house.\" This is the opposite order from English \"big house.\" The ezafe is not usually written, but it is always pronounced.",
      "fact": "The same ezafe -e/-ye links a noun to its owner too, which you already saw in نام شما (nām-e shomā, \"your name\") — one small grammatical glue connects both descriptions and possession.",
      "dialogue": [
        { "native": "این یک خانهٔ بزرگ است.", "en": "This is a big house." },
        { "native": "موتر شما نو است یا کهنه؟", "en": "Is your car new or old?" },
        { "native": "موتر من نو است.", "en": "My car is new." }
      ]
    },
    "present-tense": {
      "title": "Talking About Now: The Present Tense",
      "pattern": "می + [verb stem] + ـم/ـی/ـد/ـیم/ـید/ـند",
      "explanation": "Most Dari verbs build their present tense with می in front of a present stem, then a personal ending: می‌روم (I go), می‌روی (you go), می‌رود (he/she goes), می‌رویم (we go), می‌روید (you all go), می‌روند (they go). The tricky part is that the present stem often looks nothing like the dictionary (infinitive) form -- رفتن (raftan, \"to go\") has the stem رو (raw), and دیدن (didan, \"to see\") has the stem بین (bin). These stems have to be learned one at a time, the same way English learners must simply learn that \"go\" becomes \"went.\"",
      "fact": "Because the personal ending already shows who is doing the action, Dari sentences very often drop the separate pronoun altogether -- می‌روم alone already means \"I go,\" no من needed.",
      "dialogue": [
        { "native": "شما هر روز به مکتب می‌روید؟", "en": "Do you go to school every day?" },
        { "native": "بلی، من هر روز می‌روم.", "en": "Yes, I go every day." },
        { "native": "من هم صبح چای می‌نوشم.", "en": "I also drink tea in the morning." }
      ]
    }
  },
