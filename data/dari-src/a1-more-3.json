      "title": "Seasons",
      "titleNative": "فصل‌ها",
      "topicId": "present-tense",
      "items": [
        { "dari": "بهار فصل گل‌هاست.", "en": "Spring is the season of flowers.", "translit": "Bahār fasl-e gol-hāst." },
        { "dari": "در تابستان هوا خیلی گرم است.", "en": "In summer the weather is very hot.", "translit": "Dar tābestān hawā khaili garm ast." },
        { "dari": "در زمستان برف می‌بارد.", "en": "In winter it snows.", "translit": "Dar zemestān barf mibārad." },
        { "dari": "خزان فصل زیباست.", "en": "Autumn is a beautiful season.", "translit": "Khazān fasl-e zibāst." },
        { "dari": "در بهار باران زیاد است.", "en": "In spring there is a lot of rain.", "translit": "Dar bahār bārān ziād ast." },
        { "dari": "من تابستان را دوست دارم.", "en": "I like summer.", "translit": "Man tābestān rā dost dāram." },
        { "dari": "چهار فصل داریم: بهار، تابستان، خزان و زمستان.", "en": "We have four seasons: spring, summer, autumn, and winter.", "translit": "Chahār fasl dārim: bahār, tābestān, khazān wa zemestān." }
      ]
    },
