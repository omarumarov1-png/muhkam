  "level": "a2",
  "lessons": [
    {
      "number": 11,
      "title": "Sharing Opinions",
      "titleNative": "نظر دادن",
      "topicId": "plurals-comparatives",
      "items": [
        { "dari": "من فکر می‌کنم این کتاب خوب است.", "en": "I think this book is good.", "translit": "Man fekr mikonam in kitāb khub ast." },
        { "dari": "نظر شما چیست؟", "en": "What is your opinion?", "translit": "Nazar-e shomā chist?" },
        { "dari": "این جواب درست است.", "en": "This answer is correct.", "translit": "In jawāb dorost ast." },
        { "dari": "آن جواب غلط بود.", "en": "That answer was wrong.", "translit": "Ān jawāb ghalat bud." },
        { "dari": "من با شما موافق هستم.", "en": "I agree with you.", "translit": "Man bā shomā mowāfeq hastam." },
        { "dari": "او با این فکر مخالف است.", "en": "He/She disagrees with this idea.", "translit": "U bā in fekr mokhālef ast." }
      ]
    },
    {
      "number": 12,
      "title": "Computers and the Internet",
      "titleNative": "کمپیوتر و انترنت",
      "topicId": "past-tense",
      "items": [
        { "dari": "من یک کمپیوتر نو خریدم.", "en": "I bought a new computer.", "translit": "Man yak kampyutar-e naw kharidam." },
        { "dari": "او در انترنت درس خواند.", "en": "He/She studied on the internet.", "translit": "U dar internet dars khwānd." },
        { "dari": "ما یک ویدیو دیدیم.", "en": "We watched a video.", "translit": "Mā yak widyo didim." },
        { "dari": "این عکس خیلی زیبا است.", "en": "This photo is very beautiful.", "translit": "In aks khaili zibā ast." },
        { "dari": "برنامه شما چیست؟", "en": "What is your plan?", "translit": "Barnāma-ye shomā chist?" },
        { "dari": "کمپیوتر من کار نمی‌کند.", "en": "My computer isn't working.", "translit": "Kampyutar-e man kār nemikonad." }
      ]
    },
    {
      "number": 13,
      "title": "Holidays and Celebrations",
      "titleNative": "عید و جشن‌ها",
      "topicId": "past-tense",
      "items": [
        { "dari": "پارسال ما عید بزرگ داشتیم.", "en": "Last year we had a big Eid.", "translit": "Pārsāl mā eyd-e bozorg dāshtim." },
        { "dari": "نوروز آغاز سال نو است.", "en": "Nowruz is the beginning of the new year.", "translit": "Nawroz āghāz-e sāl-e naw ast." },
        { "dari": "در رمضان مردم روزه می‌گیرند.", "en": "In Ramadan people fast.", "translit": "Dar Ramazān mardom roza migirand." },
        { "dari": "ما در عید یک جشن بزرگ داشتیم.", "en": "We had a big celebration on Eid.", "translit": "Mā dar eyd yak jashn-e bozorg dāshtim." },
        { "dari": "خانواده من در نوروز جمع شدند.", "en": "My family gathered on Nowruz.", "translit": "Khānawāda-ye man dar Nawroz jam' shodand." }
      ]
    },
    {
      "number": 14,
      "title": "Guests and Neighbors",
      "titleNative": "مهمان و همسایه",
      "topicId": "past-tense",
      "items": [
        { "dari": "دیشب ما مهمان داشتیم.", "en": "Last night we had a guest.", "translit": "Dishab mā mehmān dāshtim." },
        { "dari": "همسایه ما خیلی مهربان است.", "en": "Our neighbor is very kind.", "translit": "Hamsāya-ye mā khaili mehrabān ast." },
        { "dari": "ما یک میهمانی بزرگ داشتیم.", "en": "We had a big party.", "translit": "Mā yak mehmāni-ye bozorg dāshtim." },
        { "dari": "مهمانان زیاد به خانه ما آمدند.", "en": "Many guests came to our house.", "translit": "Mehmānān-e ziyād ba khāna-ye mā āmadand." },
        { "dari": "همسایگان ما خوب هستند.", "en": "Our neighbors are good.", "translit": "Hamsāyagān-e mā khub hastand." }
      ]
    },
    {
      "number": 15,
      "title": "City and Village",
      "titleNative": "شهر و قریه",
      "topicId": "plurals-comparatives",
      "items": [
        { "dari": "کابل یک شهر بزرگ است.", "en": "Kabul is a big city.", "translit": "Kābul yak shahr-e bozorg ast." },
        { "dari": "قریه ما کوچک است.", "en": "Our village is small.", "translit": "Qaryah-ye mā kuchak ast." },
        { "dari": "شهر از دهات بزرگ‌تر است.", "en": "The city is bigger than the countryside.", "translit": "Shahr az dehāt bozorgtar ast." },
        { "dari": "زندگی در دهات آرام‌تر است.", "en": "Life in the countryside is calmer.", "translit": "Zendagi dar dehāt ārāmtar ast." },
        { "dari": "من در یک قریه کوچک بزرگ شدم.", "en": "I grew up in a small village.", "translit": "Man dar yak qaryah-ye kuchak bozorg shodam." }
      ]
    },
    {
      "number": 16,
      "title": "Nature",
      "titleNative": "طبیعت",
      "topicId": "plurals-comparatives",
      "items": [
        { "dari": "درخت‌های زیاد در این باغ است.", "en": "There are many trees in this garden.", "translit": "Derakht-hā-ye ziyād dar in bāgh ast." },
        { "dari": "کوه‌های افغانستان بلند است.", "en": "Afghanistan's mountains are tall.", "translit": "Koh-hā-ye Afghānistān boland ast." },
        { "dari": "دریا نزدیک قریه ما است.", "en": "The river is near our village.", "translit": "Daryā nazdik-e qaryah-ye mā ast." },
        { "dari": "هوای این‌جا پاک است.", "en": "The air here is clean.", "translit": "Hawā-ye injā pāk ast." },
        { "dari": "طبیعت افغانستان خیلی زیبا است.", "en": "Afghanistan's nature is very beautiful.", "translit": "Tabi'at-e Afghānistān khaili zibā ast." },
        { "dari": "این آب کثیف است، آن آب پاک است.", "en": "This water is dirty, that water is clean.", "translit": "In āb kasif ast, ān āb pāk ast." }
      ]
    },
    {
      "number": 17,
      "title": "Necessity: Must and Should",
      "titleNative": "باید",
      "topicId": "past-tense",
      "items": [
        { "dari": "من باید به مکتب بروم.", "en": "I must go to school.", "translit": "Man bāyad ba maktab beraum." },
        { "dari": "شما باید دوا بخورید.", "en": "You must take medicine.", "translit": "Shomā bāyad dawā bekhorid." },
        { "dari": "او باید امروز کار کند.", "en": "He/She must work today.", "translit": "U bāyad emroz kār konad." },
        { "dari": "ما باید زود بیدار شویم.", "en": "We must wake up early.", "translit": "Mā bāyad zud bidār shawim." },
        { "dari": "آیا من باید پول بدهم؟", "en": "Do I have to pay money?", "translit": "Āyā man bāyad pul bedeham?" },
        { "dari": "شما باید صبر کنید.", "en": "You must wait.", "translit": "Shomā bāyad sabr konid." }
      ]
    },
    {
      "number": 18,
      "title": "Ability: Can and Cannot",
      "titleNative": "توانستن",
      "topicId": "past-tense",
      "items": [
        { "dari": "من می‌توانم دری صحبت کنم.", "en": "I can speak Dari.", "translit": "Man mitawānam Dari sohbat konam." },
        { "dari": "او نمی‌تواند شنا کند.", "en": "He/She cannot swim.", "translit": "U nemitawānad shenā konad." },
        { "dari": "شما می‌توانید کمک کنید؟", "en": "Can you help?", "translit": "Shomā mitawānid komak konid?" },
        { "dari": "ما نتوانستیم دیروز بیاییم.", "en": "We could not come yesterday.", "translit": "Mā natawānestim diroz biyāyim." },
        { "dari": "آیا او می‌تواند این کتاب را بخواند؟", "en": "Can he/she read this book?", "translit": "Āyā u mitawānad in kitāb rā bekhwānad?" }
      ]
    },
    {
      "number": 19,
      "title": "Making Plans",
      "titleNative": "پلان کردن",
      "topicId": "past-tense",
      "items": [
        { "dari": "فردا می‌خواهیم به بازار برویم.", "en": "Tomorrow we want to go to the market.", "translit": "Fardā mikhwāhim ba bāzār beraim." },
        { "dari": "او می‌خواهد داکتر شود.", "en": "He/She wants to become a doctor.", "translit": "U mikhwāhad dāktar shawad." },
        { "dari": "ما پلان داریم که سفر کنیم.", "en": "We have a plan to travel.", "translit": "Mā palān dārim ke safar konim." },
        { "dari": "شما چه وقت می‌خواهید بیایید؟", "en": "When do you want to come?", "translit": "Shomā che waqt mikhwāhid biyāyid?" },
        { "dari": "من می‌خواهم زبان انگلیسی یاد بگیرم.", "en": "I want to learn the English language.", "translit": "Man mikhwāham zabān-e engelisi yād begiram." }
      ]
    },
    {
      "number": 20,
      "title": "Review: A Story",
      "titleNative": "تکرار: یک داستان",
      "topicId": "past-tense",
      "items": [
        { "dari": "پارسال من به کابل سفر کردم.", "en": "Last year I traveled to Kabul.", "translit": "Pārsāl man ba Kābul safar kardam." },
        { "dari": "من در یک هوتل نزدیک بازار ماندم.", "en": "I stayed in a hotel near the market.", "translit": "Man dar yak hotel-e nazdik-e bāzār māndam." },
        { "dari": "هر روز به بازار می‌رفتم و چیزهای نو می‌دیدم.", "en": "Every day I would go to the market and see new things.", "translit": "Har roz ba bāzār miraftam wa chizhā-ye naw midi dam." },
        { "dari": "یک روز مریض شدم، اما بعد صحت من خوب شد.", "en": "One day I got sick, but then my health got better.", "translit": "Yak roz mariz shodam, ammā ba'd sehat-e man khub shod." },
        { "dari": "این سفر بهترین سفر زندگی من بود.", "en": "This trip was the best trip of my life.", "translit": "In safar behtarin safar-e zendagi-e man bud." }
      ]
    }
  ]
}
