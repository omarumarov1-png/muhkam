    {
      "number": 88,
      "title": "At the Dentist",
      "titleNative": "در دندان‌پزشکی",
      "items": [
        {
          "dari": "من دندان درد دارم.",
          "en": "I have a toothache.",
          "translit": "Man dandān dard dāram."
        },
        {
          "dari": "به دندان‌پزشک زنگ زدم.",
          "en": "I called the dentist.",
          "translit": "Ba dandān-pezeshk zang zadam."
        },
        {
          "dari": "دندان‌پزشک دندانم را دید.",
          "en": "The dentist looked at my tooth.",
          "translit": "Dandān-pezeshk dandānam rā did."
        },
        {
          "dari": "این دندان خراب است.",
          "en": "This tooth is bad.",
          "translit": "In dandān kharāb ast."
        },
        {
          "dari": "فردا نوبت دندان‌پزشکی دارم.",
          "en": "I have a dentist appointment tomorrow.",
          "translit": "Fardā nawbat-e dandān-pezeshki dāram."
        },
        {
          "dari": "بعد از دیدن دندان‌پزشک، بهتر شدم.",
          "en": "After seeing the dentist, I got better.",
          "translit": "Ba'd az didan-e dandān-pezeshk, behtar shudam."
        },
        {
          "dari": "دندان‌هایت را هر روز تمیز کن.",
          "en": "Clean your teeth every day.",
          "translit": "Dandān-hāyat rā har roz tamiz kun."
        }
      ]
    },
    {
